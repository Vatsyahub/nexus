# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
!.env.example

# Prisma-generated agent skill clutter
.agents/
.claude/
.windsurf/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma client is generated on postinstall / db:generate
/src/generated/

/src/generated/prisma

# local build output, logs, and database files
/dist/
/logs/
*.log
*.sqlite
*.sqlite3
*.db

# Local restorable snapshots (they include .env). Never commit.
/backups/nexus-hub-*/
/backups/nexus-hub-*.tar.gz
/backups/BACKUP.txt

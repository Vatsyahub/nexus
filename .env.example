DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexus?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
# Do NOT set AUTH_URL to a free tunnel hostname — it goes stale and breaks navigation.
# Auth redirects are rewritten to relative paths in the auth route handler.
SEED_MASTER_EMAIL="master@cradle.local"
SEED_MASTER_PASSWORD="change-me-on-first-login"
SEED_MASTER_NAME="Master Admin"
# Master only. Typed in the password field if the Master password is forgotten.
# At least 8 characters. Leave empty to disable. Not shown on the login screen.
MASTER_RECOVERY_CODE=""
